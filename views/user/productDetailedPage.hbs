<title>AURA PERFUMES | Discover Your Signature Scent</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    /* Fix the navbar at the top */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
    }

    /* Add padding to prevent content overlapping navbar */
    body {
      padding-top: 1rem;
    }

    /* Category Grid Styling */
    .categories {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 2rem;
    }

    .category {
      background-color: white;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .category:hover {
      transform: translateY(-10px);
    }

    .category img {
      width: 100%;
      height: 150px;  /* Adjusted size */
      object-fit: cover;
      border-radius: 8px;
    }

    .category h3 {
      margin-top: 1rem;
      font-size: 1.25rem;
      font-weight: bold;
    }

    /* Image Zoom on Hover */
    .image-zoom {
      transition: transform 0.9s ease;
      cursor: zoom-in;
    }

    .image-zoom:hover {
      transform: scale(1.2);
    }

    /* Adjusting the product detail layout */
    .product-detail {
      margin-top: 2px;
    }

    .product-image img {
      max-width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 8px;
      width: 500px;
      height: 500px;
    }

    .product-info {
      padding-left: 2rem;
    }

    .related-products img {
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: 8px;
    }.related-products {
        margin-top: 8rem; /* Add space above the related products */
     

    }footer {
  margin-top: 10rem; /* Add space above the footer to avoid overlap */
     }

    /* Additional Image Thumbnails */
    .product-thumbnails img {
      width: 100px;
      height: 100px;
      object-fit: cover;
      border-radius: 8px;
      margin-right: 1rem;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .product-thumbnails img:hover {
      transform: scale(1.1);
    }

    
  </style>

<body>
  <!-- Navbar -->
  <nav class="bg-[#FDBA74] text-black shadow-md">
    <div class="container mx-auto px-4 flex justify-between items-center h-16">
      <!-- Logo -->
      <a href="#" class="text-xl font-bold">AURA PERFUMES</a>

      <!-- Hamburger Menu (Mobile) -->
      <button id="menu-btn" class="block md:hidden focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Menu Links -->
      <div id="menu" class="hidden md:flex space-x-6">
        <a href="/user/home" class="hover:text-gray-700">Home</a>
        <a href="#" class="hover:text-gray-700">About</a>
        <a href="#" class="hover:text-gray-700">Contact</a>
      </div>

      <!-- Icons Section -->
      <div class="flex space-x-4 items-center">
        <script>
  // Check if the URL contains the query parameter loggedOut=true
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('loggedOut') && urlParams.get('loggedOut') === 'true') {
    // Show a small toast notification instead of a full alert
    Swal.fire({
      toast: true,
      position: 'top-end', // You can change it to 'bottom-end', 'top-start', etc.
      icon: 'success',
      title: 'Logged Out',
      text: 'You have successfully logged out.',
      showConfirmButton: false,
      timer: 3000, // Auto-close after 3 seconds
      timerProgressBar: true
    });

    // Optionally, clear the query parameter from the URL to prevent re-triggering on refresh
    history.replaceState(null, null, window.location.pathname);
  }
</script>

        

        <!-- Welcome Message -->
        {{#if user}} <!-- Check if user is logged in -->
          <span class="text-sm font-medium">Welcome, {{user.fullName}}!</span>
        {{/if}}

        <div class="relative">
          <!-- Profile Icon Button -->
          <a href="#" id="profile-button" class="hover:opacity-80">
            <img src="/images/person_13924070.png" alt="person" class="h-6 w-6 cursor-pointer">
          </a>

          <!-- Dropdown Menu -->
          <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg hidden">
            {{#if user}}
              <!-- Show these links when the user is logged in -->
              <a href="/user/profile" class="block px-4 py-2 text-black hover:bg-gray-100">View Profile</a>
              <a href="/user/logout" class="block px-4 py-2 text-black hover:bg-gray-100">Logout</a>
            {{else}}
              <!-- Show Sign In link when the user is not logged in -->
              <a id="login-link" href="/user/login?redirect={{req.originalUrl}}" class="block px-4 py-2 text-black hover:bg-gray-100">
               Sign In
                  </a>
            {{/if}}
          </div>
        </div>

        <script>
          // Show/hide the dropdown menu
          document.getElementById('profile-button').addEventListener('click', function () {
            const dropdown = document.getElementById('profile-dropdown');
            dropdown.classList.toggle('hidden');
          });
        </script>

        <a href="#" class="hover:opacity-80">
          <img src="/images/cart_17658761.png" alt="Cart" class="h-8 w-8">
        </a>
        <a href="#" class="hover:opacity-80">
          <img src="/images/heart.png" alt="wishlist" class="h-8 w-8 rounded-full">
        </a>
      </div>
    </div>
  </nav>
  

  <!-- Breadcrumbs (Moved Below Navbar) -->
  <section class="breadcrumb mb-6 pt-16 px-4">
  <a href="/user/home" class="text-blue-500 hover:underline">Home</a> /
  <a href="/user/category/{{product.category.name}}" class="text-blue-500 hover:underline">{{product.category.name}}</a> /
  <span class="text-gray-500">{{product.name}}</span>
  </section>

<!-- Product Detail Section -->
  <section class="product-detail px-4 lg:px-24 py-10 mt-1">  
   <div class="flex flex-col lg:flex-row gap-10">
    <!-- Left Section: Product Images -->
     <div class="flex gap-5 items-start">
      <!-- Thumbnail Images (Side Grid) -->
      <div class="grid grid-cols-1 gap-3">
        <img src="{{product.firstImage}}" alt="Thumbnail 1"
          onclick="document.getElementById('main-product-image').src='{{product.firstImage}}'"
          class="w-20 h-20 object-cover rounded-md cursor-pointer shadow-md border-2 border-gray-200 hover:border-black transition-all duration-200">
        
        <img src="{{product.secondImage}}" alt="Thumbnail 2"
          onclick="document.getElementById('main-product-image').src='{{product.secondImage}}'"
          class="w-20 h-20 object-cover rounded-md cursor-pointer shadow-md border-2 border-gray-200 hover:border-black transition-all duration-200">
        
        <img src="{{product.thirdImage}}" alt="Thumbnail 3"
          onclick="document.getElementById('main-product-image').src='{{product.thirdImage}}'"
          class="w-20 h-20 object-cover rounded-md cursor-pointer shadow-md border-2 border-gray-200 hover:border-black transition-all duration-200">
          
          <img src="{{product.mainImage}}" alt="Thumbnail 2"
          onclick="document.getElementById('main-product-image').src='{{product.mainImage}}'"
          class="w-20 h-20 object-cover rounded-md cursor-pointer shadow-md border-2 border-gray-200 hover:border-black transition-all duration-200">
      </div>

      <!-- Main Product Image -->
      <div class="w-full">
        <img id="main-product-image" src="{{product.mainImage}}" alt="{{product.name}}"
          class="w-[450px] h-[450px] object-cover rounded-lg shadow-lg border border-gray-300">
      </div>
    </div>

    <!-- Right Section: Product Information -->
    <div class="product-info lg:w-1/2">
      <h1 class="text-3xl font-bold text-gray-800 mb-4">{{product.name}}</h1>
      <p class="text-gray-500 mb-6">{{product.description}}</p>

      <!-- Price and Discount Section -->
      <div class="price-section mb-6">
        <p class="text-xl font-semibold text-gray-700">
          Original Price: <span class="line-through text-gray-400">₹{{product.price}}</span>
        </p>
        <p class="text-red-500 text-lg font-medium">Discount: {{product.discount}}% off</p>
        <p class="text-3xl text-green-600 font-bold">
          Offer Price: ₹{{calculateOfferPrice product.price product.discount}}
        </p>
        <p class="text-green-600 font-medium">(Inclusive of all taxes)</p>
      </div>

      <!-- Stock Availability -->
      <div class="stock-status mb-6">
        {{#ifEquals product.stock 0}}
          <p class="text-red-500">Sorry, out of stock</p>
        {{else if product.isSoldOut}}
          <p class="text-red-500">Sold Out</p>
        {{else if product.isUnavailable}}
          <p class="text-red-500">Unavailable</p>
        {{/ifEquals}}
      </div>

      <!-- Product Highlights or Specifications -->
      <div class="product-specs mb-6">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">🔹 Highlights</h3>
        <ul class="list-disc pl-6 text-gray-600">
          {{#each product.highlights}}
            <li class="text-gray-700">{{this}}</li>
          {{/each}}
        </ul>
      </div>

      <!-- Add to Cart Button -->
      <button class="bg-blue-500 text-white py-3 px-6 rounded-lg mt-6 hover:bg-blue-600 transition duration-200 ease-in-out transform hover:scale-105">
        Add to Cart
      </button>
    </div>
  </div>
</section>


{{!-- Related Product Section --}}
<section class="related-products mt-10 px-4 lg:px-24">
  <h2 class="text-2xl font-semibold text-gray-800 mb-6">Related Products</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {{#each relatedProducts}}
      <div class="border p-4 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 w-50 flex flex-col h-full">
        <!-- Wrapper to center content -->
        <div class="flex flex-col h-full justify-between">
          <!-- Adjusted Image Size -->
          <a href="/user/product/{{this._id}}">
            <img src="{{this.mainImage}}" alt="{{this.name}}" class="w-40 h-40 object-cover rounded-lg mb-4 transition-transform duration-200 hover:scale-105" />
          </a>
          
          <!-- Text content and button -->
          <div class="flex flex-col items-center flex-grow">
            <h3 class="text-lg font-semibold text-gray-800 mb-2 text-center">{{this.name}}</h3>
            <p class="text-sm text-gray-500 mb-2 text-center">
              Price: 
              <span class="line-through text-gray-400">₹{{this.price}}</span>
            </p>
            <p class="text-lg text-green-500 font-semibold text-center">
              Offer Price: ₹{{calculateOfferPrice this.price this.discount}}
            </p>
            <a href="/user/product/{{this._id}}" class="inline-block bg-blue-500 text-white py-2 px-4 rounded-lg mt-4 hover:bg-blue-600 transition duration-200">
              View Details
            </a>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>







  <!-- Footer -->
  <!-- Footer -->
<footer class="bg-black text-white py-4">
  <div class="container mx-auto text-center">
    <h4 class="text-lg font-semibold mb-2">AURA PERFUMES</h4>
    <p class="text-xs mb-2">
      "AURA: More than just fragrance, it's an experience. Find your signature scent and let it radiate your aura."
    </p>
    <div class="text-xs">
      <p><strong>Customer Service:</strong> <a href="#" class="underline hover:text-gray-400">FAQs</a> | <a href="#" class="underline hover:text-gray-400">Shipping & Returns</a></p>
      <p><strong>Contact Us:</strong> <a href="#" class="underline hover:text-gray-400">Email</a> | <a href="#" class="underline hover:text-gray-400">Phone</a></p>
      <p>&copy; 2024 AURA. All rights reserved.</p>
    </div>
  </div>
</footer>





  <script>
    // Mobile Menu Toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const profileButton = document.getElementById('profile-button');
    const profileDropdown = document.getElementById('profile-dropdown');

    // Toggle dropdown visibility on button click
    profileButton.addEventListener('click', (event) => {
      event.preventDefault(); // Prevent default link action
      profileDropdown.classList.toggle('hidden');
    });

    // Optional: Close the dropdown when clicking outside
    window.addEventListener('click', (event) => {
      if (!profileButton.contains(event.target) && !profileDropdown.contains(event.target)) {
        profileDropdown.classList.add('hidden');
      }
    });
       // Show/hide the dropdown menu
  document.getElementById('profile-button').addEventListener('click', function () {
    const dropdown = document.getElementById('profile-dropdown');
    dropdown.classList.toggle('hidden');
  });


document.addEventListener("DOMContentLoaded", function () {
    const loginLink = document.getElementById("login-link");
    if (loginLink) {
      loginLink.href = `/user/login?redirect=${encodeURIComponent(window.location.pathname)}`;
    }
  });


  </script>
</body> 