
  <title>AURA PERFUMES | Discover Your Signature Scent</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    /* Fix the navbar at the top */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
    }

    /* Add padding to prevent content overlapping navbar */
    body {
      padding-top: 4rem;
    }

    /* Category Grid Styling */
    .categories {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 2rem;
    }

    .category {
      background-color: white;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .category:hover {
      transform: translateY(-10px);
    }

    .category img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
    }

    .category h3 {
      margin-top: 1rem;
      font-size: 1.25rem;
      font-weight: bold;
    }
  </style>

<body>
  <!-- Navbar -->
  <nav class="bg-[#FDBA74] text-black shadow-md">
    <div class="container mx-auto px-4 flex justify-between items-center h-16">
      <!-- Logo -->
      <a href="#" class="text-xl font-bold">AURA PERFUMES</a>

      <!-- Hamburger Menu (Mobile) -->
      <button id="menu-btn" class="block md:hidden focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Menu Links -->
      <div id="menu" class="hidden md:flex space-x-6">
        <a href="/user/home" class="hover:text-gray-700">Home</a>
        <a href="#" class="hover:text-gray-700">About</a>
        <a href="#" class="hover:text-gray-700">Contact</a>
      </div>

      <!-- Icons Section -->
      <div class="flex space-x-4 items-center">
        <script>
  // Check if the URL contains the query parameter loggedOut=true
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('loggedOut') && urlParams.get('loggedOut') === 'true') {
    // Show a small toast notification instead of a full alert
    Swal.fire({
      toast: true,
      position: 'top-end', // You can change it to 'bottom-end', 'top-start', etc.
      icon: 'success',
      title: 'Logged Out',
      text: 'You have successfully logged out.',
      showConfirmButton: false,
      timer: 3000, // Auto-close after 3 seconds
      timerProgressBar: true
    });

    // Optionally, clear the query parameter from the URL to prevent re-triggering on refresh
    history.replaceState(null, null, window.location.pathname);
  }
</script>

        

        <!-- Welcome Message -->
        {{#if user}} <!-- Check if user is logged in -->
          <span class="text-sm font-medium">Welcome, {{user.fullName}}!</span>
        {{/if}}

        <div class="relative">
          <!-- Profile Icon Button -->
          <a href="#" id="profile-button" class="hover:opacity-80">
            <img src="/images/person_13924070.png" alt="person" class="h-6 w-6 cursor-pointer">
          </a>

          <!-- Dropdown Menu -->
          <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg hidden">
            {{#if user}}
              <!-- Show these links when the user is logged in -->
              <a href="/user/profile" class="block px-4 py-2 text-black hover:bg-gray-100">View Profile</a>
              <a href="/user/logout" class="block px-4 py-2 text-black hover:bg-gray-100">Logout</a>
            {{else}}
              <!-- Show Sign In link when the user is not logged in -->
              {{!-- <a href="/user/login" class="block px-4 py-2 text-black hover:bg-gray-100">Sign In</a> --}}
              <a id="login-link" href="/user/login?redirect={{req.originalUrl}}" class="block px-4 py-2 text-black hover:bg-gray-100">
               Sign In
                  </a>



            {{/if}}
          </div>
        </div>

        <script>
          // Show/hide the dropdown menu
          document.getElementById('profile-button').addEventListener('click', function () {
            const dropdown = document.getElementById('profile-dropdown');
            dropdown.classList.toggle('hidden');
          });
        </script>

        <a href="#" class="hover:opacity-80">
          <img src="/images/cart_17658761.png" alt="Cart" class="h-8 w-8">
        </a>
        <a href="#" class="hover:opacity-80">
          <img src="/images/heart.png" alt="wishlist" class="h-8 w-8 rounded-full">
        </a>
      </div>
    </div>
  </nav>

 <!-- Category Title -->
<section class="container mx-auto px-4 py-12">
  <h1 class="text-center text-2xl font-semibold mb-6">{{category.name}} - Products</h1>

  <!-- Product List -->
  {{#if products}}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
      {{#each products}}
        {{#unless this.isDeleted}}
          <div class="border p-2 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 w-64 flex flex-col items-center">
            <a href="/user/product/{{this._id}}">
              <img src="{{this.mainImage}}" alt="{{this.name}}" class="w-52 h-52 object-cover rounded-lg mb-2 transition-transform duration-200 hover:scale-105" />
            </a>
            <h3 class="text-sm font-semibold text-center text-gray-800">{{this.name}}</h3>
            <p class="text-xs text-gray-500 text-center mt-1">
              <span class="line-through text-gray-400">Original Price ₹{{this.price}}</span>
              <br>
              <strong class="text-green-500 text-sm">Offer Price ₹{{calculateOfferPrice this.price this.discount}}</strong>
            </p>
            <a href="/user/product/{{this._id}}" class="bg-blue-500 text-white text-xs py-2 px-3 rounded-lg mt-2 hover:bg-blue-600 transition duration-200">
              View Details
            </a>
          </div>
        {{/unless}}
      {{/each}}
    </div>
  {{else}}
    <p class="text-center text-gray-500">No active products available in this category.</p>
  {{/if}}
</section>



  <!-- Footer -->
<footer class="bg-black text-white py-4">
  <div class="container mx-auto text-center">
    <h4 class="text-lg font-semibold mb-2">AURA PERFUMES</h4>
    <p class="text-xs mb-2">
      "AURA: More than just fragrance, it's an experience. Find your signature scent and let it radiate your aura."
    </p>
    <div class="text-xs">
      <p><strong>Customer Service:</strong> <a href="#" class="underline hover:text-gray-400">FAQs</a> | <a href="#" class="underline hover:text-gray-400">Shipping & Returns</a></p>
      <p><strong>Contact Us:</strong> <a href="#" class="underline hover:text-gray-400">Email</a> | <a href="#" class="underline hover:text-gray-400">Phone</a></p>
      <p>&copy; 2024 AURA. All rights reserved.</p>
    </div>
  </div>
</footer>


  <script>
    // Mobile Menu Toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const profileButton = document.getElementById('profile-button');
    const profileDropdown = document.getElementById('profile-dropdown');

    // Toggle dropdown visibility on button click
    profileButton.addEventListener('click', (event) => {
      event.preventDefault(); // Prevent default link action
      profileDropdown.classList.toggle('hidden');
    });

    // Optional: Close the dropdown when clicking outside
    window.addEventListener('click', (event) => {
      if (!profileDropdown.contains(event.target) && !profileButton.contains(event.target)) {
        profileDropdown.classList.add('hidden');
      }
    });

       // Show/hide the dropdown menu
  document.getElementById('profile-button').addEventListener('click', function () {
    const dropdown = document.getElementById('profile-dropdown');
    dropdown.classList.toggle('hidden');
  });



  document.addEventListener("DOMContentLoaded", function () {
    const loginLink = document.getElementById("login-link");
    if (loginLink) {
      loginLink.href = `/user/login?redirect=${encodeURIComponent(window.location.pathname)}`;
    }
  });
  </script>
</body>

