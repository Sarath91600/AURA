{{! Register Page }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-red-100 flex items-center justify-center min-h-screen">
  <div class="w-full max-w-4xl mx-auto bg-red-100 shadow-lg rounded-lg flex overflow-hidden">
    
    <!-- Image Section -->
    <div class="hidden md:flex w-1/2 bg-red-100 items-center justify-center p-8">
      <img src="/images/LOGO.jpg" alt="Aura Perfumes" class="w-3/4 rounded-lg">
    </div>
    
    <!-- Form Section -->
    <div class="w-full md:w-1/2 p-8">
      <h1 class="text-2xl font-bold mb-6 text-center text-gray-800">Register</h1>
      
     {{#if message }}
        <p class="text-red-500" id="server-error">{{message}}</p>
      {{else}}
        <p class="text-red-500 hidden" id="error-message"></p>
      {{/if}}
      
      <form action="/user/register" method="POST" onsubmit="return formValidate()">
      <input type="hidden" id="redirect" name="redirect" value="">
        
        <!-- Full Name Field -->
        <div class="mb-4">
          <label for="reg-full-name" class="block text-gray-700 font-medium mb-2">Full Name</label>
          <input type="text" id="reg-full-name" name="fullName" placeholder="Full Name" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" >
        </div>

        <!-- Mobile Number Field -->
        <div class="mb-4">
          <label for="reg-mobile" class="block text-gray-700 font-medium mb-2">Mobile</label>
          <input type="tel" id="reg-mobile" name="mobile" placeholder="Mobile Number" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        
        <!-- Email Field -->
        <div class="mb-4">
          <label for="reg-email" class="block text-gray-700 font-medium mb-2">Email</label>
          <input type="email" id="reg-email" name="email" placeholder="Email Address" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="clearError()">
        </div>
        
        <!-- Password Field -->
        <div class="mb-4 relative">
          <label for="reg-password" class="block text-gray-700 font-medium mb-2">Password</label>
          <div class="relative">
            <input type="password" id="reg-password" name="password" placeholder="Password"
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <img src="/images/iconmonstr-eye-8.svg" id="toggle-password" class="absolute right-3 top-3 w-6 h-6 cursor-pointer"
              onclick="togglePassword('reg-password', 'toggle-password')">
          </div>
        </div>

        <!-- Confirm Password Field -->
        <div class="mb-6 relative">
          <label for="reg-confirm-password" class="block text-gray-700 font-medium mb-2">Confirm Password</label>
          <div class="relative">
            <input type="password" id="reg-confirm-password" name="confirmPassword" placeholder="Confirm Password"
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            <img src="/images/iconmonstr-eye-8.svg" id="toggle-confirm-password"
              class="absolute right-3 top-3 w-6 h-6 cursor-pointer"
              onclick="togglePassword('reg-confirm-password', 'toggle-confirm-password')">
          </div>
        </div>
        
        
        <!-- Submit Button -->
        <button type="submit" class="w-full bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600">Register</button>
      </form>

      <!-- Google Login Button -->
      <div class="mt-4">
        <a href="/user/auth/google"
           class="w-full bg-blue-600 text-white font-semibold rounded-lg px-4 py-2 hover:bg-blue-700 focus:ring-2 focus:ring-indigo-400 transition duration-200 ease-in-out flex items-center justify-center"
           aria-label="Continue with Google">
           <img src="/images/pngwing.com.png" alt="Google logo" class="h-6 w-6 mr-2">
           Continue with Google
        </a>
      </div>
      
      <!-- Login Link -->
      <div class="mt-4 text-center">
        <p class="text-gray-700">Already have an account? <a href="/user/login" class="text-blue-500">Login</a></p>
      </div>
    </div>
  </div>

  <script>
    const errorMessage = document.getElementById("error-message");

    function clearError() {
      if (errorMessage) {
        errorMessage.innerText = "";
        errorMessage.classList.add("hidden");
      }
    }

    function formValidate() {
      let fullName = document.getElementById("reg-full-name").value.trim();
      let mobile = document.getElementById("reg-mobile").value.trim();
      let email = document.getElementById("reg-email").value.trim();
      let password = document.getElementById("reg-password").value.trim();
      let confirmPassword = document.getElementById("reg-confirm-password").value.trim();

    // Full Name Validation (Empty or only spaces not allowed)
  if (!fullName || fullName.replace(/\s/g, '') === "") {
    errorMessage.innerText = "Full Name cannot be empty or contain only spaces!";
    errorMessage.classList.remove("hidden");
    return false;
  }

      if (!fullName) {
        errorMessage.innerText = "Please enter your name!";
        errorMessage.classList.remove("hidden");
        return false;
      }

      const mobilePattern = /^[0-9]{10}$/;
      if (!mobilePattern.test(mobile)) {
        errorMessage.innerText = "Mobile number must be 10 digits!";
        errorMessage.classList.remove("hidden");
        return false;
      }
      // Password Validation (At least 4 characters and no spaces)
 
  const passwordPattern = /^(?!.*\s)(?!.*\s$).{4,}$/
  if (!passwordPattern.test(password)) {
    errorMessage.innerText = "Password must be at least 4 characters and cannot contain spaces!";
    errorMessage.classList.remove("hidden");
    return false;
  }


      if (password !== confirmPassword) {
        errorMessage.innerText = "Passwords do not match!";
        errorMessage.classList.remove("hidden");
        return false;
      }

      errorMessage.classList.add("hidden");
      return true;
    }

    function togglePassword(fieldId, eyeIconId) {
      let passwordField = document.getElementById(fieldId);
      let eyeIcon = document.getElementById(eyeIconId);
      
      if (passwordField.type === "password") {
        passwordField.type = "text";
        eyeIcon.src = "/images/iconmonstr-eye-4-240.png"; // Change to 'eye-off' when password is visible
      } else {
        passwordField.type = "password";
        eyeIcon.src = "/images/iconmonstr-eye-8.svg"; // Change back to 'eye' when password is hidden
      }
    }

    document.querySelectorAll("#reg-full-name, #reg-mobile, #reg-email, #reg-password, #reg-confirm-password").forEach(input => {
      input.addEventListener("input", clearError);
    });

        // Capture current URL before submitting
    document.getElementById("redirect").value = window.location.href;
  </script>
</body>
</html>
