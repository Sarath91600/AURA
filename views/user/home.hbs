
<title>AURA PERFUMES | Discover Your Signature Scent</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Fix the navbar at the top */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
    }

    /* Add padding to prevent content overlapping navbar */
    body {
      padding-top: 4rem;
    }

    /* Category Grid Styling */
    .categories {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 2rem;
    }

    .category {
      background-color: white;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .category:hover {
      transform: translateY(-10px);
    }

    .category img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
    }

    .category h3 {
      margin-top: 1rem;
      font-size: 1.25rem;
      font-weight: bold;
    }
  </style>

<body class="bg-[#FDBA74]">
  <!-- Navbar -->
<nav class="bg-[#FDBA74] text-black shadow-md">
  <div class="container mx-auto px-4 flex justify-between items-center h-16">
    <!-- Logo -->
    <a href="#" class="text-xl font-bold">AURA PERFUMES</a>

    <!-- Hamburger Menu (Mobile) -->
    <button id="menu-btn" class="block md:hidden focus:outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Menu Links -->
    <div id="menu" class="hidden md:flex space-x-6">
      <a href="#" class="hover:text-gray-700">Home</a>
      <a href="#" class="hover:text-gray-700">About</a>
      <a href="#" class="hover:text-gray-700">Contact</a>
    </div>

    <!-- Icons Section -->
    <div class="flex space-x-4 items-center">
      {{#if logoutSuccess}}
  <script>
    alert('Successfully logged out!');
  </script>
{{/if}}
      

      <!-- Welcome Message -->
      {{#if user}} <!-- Check if user is logged in -->
        <span class="text-sm font-medium">Welcome, {{user.fullName}}!</span>
      {{/if}}

      <div class="relative">
        <!-- Profile Icon Button -->
        <a href="#" id="profile-button" class="hover:opacity-80">
          <img src="/images/person_13924070.png" alt="person" class="h-6 w-6 cursor-pointer">
        </a>

        <!-- Dropdown Menu -->
        <div 
          id="profile-dropdown" 
          class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg hidden"
        >
          <a href="/user/login" class="block px-4 py-2 text-black hover:bg-gray-100">Sign In</a>
          <a href="#" class="block px-4 py-2 text-black hover:bg-gray-100">View Profile</a>
          <a href="/user/logout" class="block px-4 py-2 text-black hover:bg-gray-100">Logout</a>
        </div>
      </div>

      <a href="#" class="hover:opacity-80">
        <img src="/images/cart_17658761.png" alt="Cart" class="h-8 w-8">
      </a>
      <a href="#" class="hover:opacity-80">
        <img src="/images/heart.png" alt="wishlist" class="h-8 w-8 rounded-full">
      </a>
    </div>
  </div>
</nav>


 <!-- Hero Section -->
<div class="w-full">
  <img src="/images/freepik__the-style-is-candid-image-photography-with-natural__11533.png" 
       alt="Descriptive Text" 
       class="w-full h-74 object-cover">
</div>

  <!-- Categories Section on Home Page -->
  <section class="container mx-auto px-4 py-12 bg-[#FDBA74]">
    <!-- Categories Section on Home Page -->
<h2 class="text-center text-2xl font-semibold mb-6">CATEGORIES</h2>

{{#if categories}}
  <div class="flex justify-center flex-wrap gap-6">
    {{#each categories}}
      <div class="category w-1/4 sm:w-1/3 md:w-1/4 lg:w-1/5 p-4">
        <!-- Link to redirect to the category's products page -->
        <a href="/category/{{this.name}}" class="block">
          <img src="/uploads/{{this.image}}" alt="{{this.name}}" class="w-full h-auto mb-4" />
          <h3 class="text-center text-lg font-medium">{{this.name}}</h3>
        </a>
      </div>
    {{/each}}
  </div>
{{else}}
  <p>No categories available.</p>
{{/if}}
</section>
<!-- New Collections Section -->
<section class="new-collections mt-12 px-4 lg:px-24 bg-[#FDBA74]">
  <h2 class="text-4xl font-semibold text-gray-900 mb-10 text-center">New Collections</h2>
  <div class="flex justify-center flex-wrap gap-6">
    {{#each newProducts}}
      <div class="category w-1/4 sm:w-1/3 md:w-1/4 lg:w-1/5 p-4">
        <!-- Link to redirect to the product page -->
        <a href="/product/{{this._id}}" class="block">
          <img src="{{this.mainImage}}" alt="{{this.name}}" class="w-full h-auto mb-4 rounded-lg" />
          <h3 class="text-center text-lg font-medium text-gray-800">{{this.name}}</h3>
        </a>
      </div>
    {{/each}}
  </div>
</section>




  <!-- Body Text -->
  <div class="bg-black bg-opacity-70 text-[#D4AF37] py-1">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold text-center">AURA PERFUMES <br>Discover your Signature Scent</h1>
      <p class="mt-4 text-lg text-center">
        Discover the finest collection of perfumes that suit your unique style. Experience luxury, elegance, and timeless fragrances with us.
      </p>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-black text-white py-8">
    <div class="container mx-auto text-center">
      <h4 class="text-xl font-bold mb-4">AURA PERFUMES</h4>
      <p class="text-sm mb-4">
        "AURA: More than just fragrance, it's an experience. Indulge in our luxurious collection of perfumes, athar oils, and diffusers, each designed to elevate your mood and awaken your senses. Find your signature scent and let it radiate your aura."
      </p>
      <div class="space-y-2">
        <p><strong>Customer Service:</strong> <a href="#" class="underline hover:text-gray-400">FAQs</a> | <a href="#" class="underline hover:text-gray-400">Shipping & Returns</a></p>
        <p><strong>Contact Us:</strong> <a href="#" class="underline hover:text-gray-400">Email</a> | <a href="#" class="underline hover:text-gray-400">Phone</a></p>
        <p>&copy; 2024 AURA. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    // Mobile Menu Toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const profileButton = document.getElementById('profile-button');
    const profileDropdown = document.getElementById('profile-dropdown');

    // Toggle dropdown visibility on button click
    profileButton.addEventListener('click', (event) => {
      event.preventDefault(); // Prevent default link action
      profileDropdown.classList.toggle('hidden');
    });

    // Optional: Close the dropdown when clicking outside
    window.addEventListener('click', (event) => {
      if (!profileDropdown.contains(event.target) && !profileButton.contains(event.target)) {
        profileDropdown.classList.add('hidden');
      }
    });
  </script>
</body>