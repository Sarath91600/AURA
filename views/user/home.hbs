

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURA PERFUMES | Discover Your Signature Scent</title>

  <!-- TailwindCSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* Fix the navbar at the top */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
    }

    /* Add padding to prevent content overlapping navbar */
    body {
      padding-top: 4rem;
    }

    /* Category Grid Styling */
    .categories {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 2rem;
    }

    .category {
      background-color: white;
      padding: 1rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .category:hover {
      transform: translateY(-10px);
    }

    .category img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
    }

    .category h3 {
      margin-top: 1rem;
      font-size: 1.25rem;
      font-weight: bold;
    }
  </style>
</head>

<body class="bg-[#FDBA74]">
  <nav class="bg-[#FDBA74] text-black shadow-md">
  <div class="container mx-auto px-4 flex justify-between items-center h-16">
    <!-- Logo -->
    <a href="#" class="text-xl font-bold">AURA PERFUMES</a>

    <!-- Hamburger Menu (Mobile) -->
    <button id="menu-btn" class="block md:hidden focus:outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Menu Links -->
    <div id="menu" class="hidden md:flex md:space-x-6 absolute md:relative top-16 md:top-0 left-0 w-full md:w-auto bg-[#FDBA74] md:bg-transparent flex-col md:flex-row items-center md:items-center space-y-4 md:space-y-0 py-4 md:py-0 shadow-md md:shadow-none">
      <a href="#" class="hover:text-gray-700">Home</a>
      <a href="#" class="hover:text-gray-700">About</a>
      <a href="#" class="hover:text-gray-700">Contact</a>
    </div>

    <!-- Icons Section -->
    <div class="flex space-x-4 items-center">
      <script>
        // Check if the URL contains the query parameter loggedOut=true
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('loggedOut') && urlParams.get('loggedOut') === 'true') {
          // Show a small toast notification instead of a full alert
          Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'Logged Out',
            text: 'You have successfully logged out.',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
          });

          // Optionally, clear the query parameter from the URL to prevent re-triggering on refresh
          history.replaceState(null, null, window.location.pathname);
        }
      </script>

      <!-- Welcome Message -->
      {{#if user}} 
        <span class="text-sm font-medium">Welcome, {{user.fullName}}!</span>
      {{/if}}

      <div class="relative">
        <!-- Profile Icon Button -->
        <a href="#" id="profile-button" class="hover:opacity-80">
          <img src="/images/person_13924070.png" alt="person" class="h-6 w-6 cursor-pointer">
        </a>


<!-- Dropdown Menu -->
        <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg hidden">
          {{#if user}}
            <a href="/user/profile" class="block px-4 py-2 text-black hover:bg-gray-100">View Profile</a>
            <a href="/user/logout" class="block px-4 py-2 text-black hover:bg-gray-100">Logout</a>
          {{else}}
            <a href="/user/login" class="block px-4 py-2 text-black hover:bg-gray-100">Sign In</a>
          {{/if}}
        </div>
      </div>

      <a href="#" class="hover:opacity-80">
        <img src="/images/cart_17658761.png" alt="Cart" class="h-8 w-8">
      </a>
      <a href="#" class="hover:opacity-80">
        <img src="/images/heart.png" alt="wishlist" class="h-8 w-8 rounded-full">
      </a>
    </div>
  </div>
</nav>

  <!-- Hero Section -->
  <div class="w-full">
    <img src="/images/banner.png" alt="Descriptive Text" class="w-full h-65 object-cover">
  </div>

<section class="container mx-auto px-4 py-12 bg-[#FDBA74]">
  <h2 class="text-center text-2xl font-semibold mb-6">CATEGORIES</h2>
  {{#if categories}}
    <div class="max-w-screen-lg mx-auto flex flex-wrap justify-center gap-8">
      {{#each categories}}
        <div class="category w-[160px] sm:w-[180px] md:w-[220px] p-4">
          <a href="/user/category/{{this.name}}" class="block">
            <img src="/uploads/{{this.image}}" alt="{{this.name}}" class="w-full h-auto mb-3 rounded-lg shadow-md" />
            <h3 class="text-center text-lg font-medium">{{this.name}}</h3>
          </a>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="text-center text-gray-700">No categories available.</p>
  {{/if}}
</section>

<!-- New Collections Section -->
<section class="new-collections mt-6 px-4 lg:px-24 bg-[#FDBA74]">
  <h2 class="text-3xl font-semibold text-gray-900 mb-8 text-center">New Collections</h2>
  <div class="max-w-screen-lg mx-auto flex flex-wrap justify-center gap-8">
    {{#each newProducts}}
      <div class="category w-[160px] sm:w-[180px] md:w-[220px] p-4">
        <a href="/user/product/{{this._id}}" class="block">
          <img src="{{this.mainImage}}" alt="{{this.name}}" class="w-full h-auto mb-3 rounded-lg shadow-md" />
          <p class="text-center text-lg font-medium">{{this.name}}</p>
          
        </a>
      </div>
    {{/each}}
  </div>
</section>


  <!-- Body Text -->
  <div class="bg-black bg-opacity-70 text-[#D4AF37] py-1">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold text-center">AURA PERFUMES <br>Discover your Signature Scent</h1>
      <p class="mt-4 text-lg text-center">
        Discover the finest collection of perfumes that suit your unique style. Experience luxury, elegance, and timeless fragrances with us.
      </p>
    </div>
  </div>

  <!-- Footer -->
<footer class="bg-black text-white py-4">
  <div class="container mx-auto text-center">
    <h4 class="text-lg font-semibold mb-2">AURA PERFUMES</h4>
    <p class="text-xs mb-2">
      "AURA: More than just fragrance, it's an experience. Find your signature scent and let it radiate your aura."
    </p>
    <div class="text-xs">
      <p><strong>Customer Service:</strong> <a href="#" class="underline hover:text-gray-400">FAQs</a> | <a href="#" class="underline hover:text-gray-400">Shipping & Returns</a></p>
      <p><strong>Contact Us:</strong> <a href="#" class="underline hover:text-gray-400">Email</a> | <a href="#" class="underline hover:text-gray-400">Phone</a></p>
      <p>&copy; 2024 AURA. All rights reserved.</p>
    </div>
  </div>
</footer>


<script>
  /// Mobile Menu Toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('menu');

      menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
});


document.addEventListener("DOMContentLoaded", function () {
    const profileButton = document.getElementById("profile-button");
    const profileDropdown = document.getElementById("profile-dropdown");

    profileButton.addEventListener("click", function (event) {
      event.preventDefault(); // Prevent default anchor behavior
      profileDropdown.classList.toggle("hidden");
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", function (event) {
      if (!profileButton.contains(event.target) && !profileDropdown.contains(event.target)) {
        profileDropdown.classList.add("hidden");
      }
    });
  });
  </script>


  
</body>

</html>