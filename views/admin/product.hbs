<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-full lg:w-1/5 bg-gray-800 text-white min-h-screen shadow-xl p-6">
            <h1 class="text-2xl font-bold mb-8">Admin Dashboard</h1>
            <nav>
                <ul>
                    <li class="mb-4">
                        <a href="/admin/dashboard" class="block py-2 px-4 rounded-lg hover:bg-gray-700 transition">Users</a>
                    </li>
                    <li class="mb-4">
                        <a href="/admin/categories" class="block py-2 px-4 rounded-lg hover:bg-gray-700 transition">Category</a>
                    </li>
                    <li class="mb-4">
                        <a href="/admin/product" class="block py-2 px-4 rounded-lg bg-gray-700 transition font-bold">Product</a>
                    </li>
                    <li class="mb-4">
                        <a href="/admin/logout" class="block py-2 px-4 rounded-lg hover:bg-red-600 transition">Log Out</a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="w-full lg:w-4/5 p-8">
            <!-- Add Product Button -->
            <div class="mb-6">
               <a href="/admin/addProduct" class="inline-block bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition">Add Product</a>

            </div>

            <!-- Show Added Products -->
            <h2 class="text-2xl font-semibold mb-6 text-gray-800">Product List</h2>
            <table class="table-auto w-full border-collapse border border-gray-300 rounded-lg shadow-md">
                <thead>
                    <tr class="bg-gray-200">
                        <th class="border px-6 py-3 text-sm text-gray-600">Sl no</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Name</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Category</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Price</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Stock</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Discount</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Main Image</th>
                        <th class="border px-6 py-3 text-sm text-gray-600">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each products}}
                    <tr class="bg-white hover:bg-gray-100">
                        <td class="border px-6 py-3 text-center">{{@index}}</td>
                        <td class="border px-6 py-3 text-center">{{this.name}}</td>
                        <td class="border px-6 py-3 text-center">{{this.category.name}}</td>
                        <td class="border px-6 py-3 text-center">{{this.price}}</td>
                        <td class="border px-6 py-3 text-center">{{this.stock}}</td>
                        <td class="border px-6 py-3 text-center">{{this.discount}}%</td>
                        
                       <td class="border px-6 py-3 text-center">
                            <img src="{{this.mainImage}}" alt="{{this.name}}" class="w-10 h-10 mb-4" />
                        </td>

                        <td class="border px-6 py-3 text-center">
                            <a href="/admin/editProduct/{{this._id}}" class="text-blue-500 hover:text-blue-700">Edit</a>
                            <form action="/admin/product/delete/{{this._id}}" method="POST" class="inline ml-4">
                                <button type="submit" class="text-red-500 hover:text-red-700">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
