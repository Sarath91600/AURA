<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin Dashboard - Category Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-100">

  <!-- Main Layout -->
  <div class="flex">
    <!-- Sidebar -->
    <aside class="w-1/5 bg-gray-800 text-white min-h-screen shadow-lg p-6">
      <h1 class="text-2xl font-bold mb-4">Admin Dashboard</h1>
      <nav>
        <ul>
          <li class="mb-2"><a href="/admin/dashboard" class="block py-2 px-4 rounded-lg hover:bg-gray-700 transition">Users</a></li>
          <li class="mb-2"><a href="/admin/categories" class="block py-2 px-4 rounded-lg bg-gray-700 transition font-bold">Category</a></li>
          <li class="mb-2"><a href="/admin/product" class="block py-2 px-4 rounded-lg hover:bg-gray-700 transition">Product</a></li>
          <li class="mb-2"><a href="/admin/logout" class="block py-2 px-4 rounded-lg hover:bg-red-600 transition">Log Out</a></li>
        </ul>
      </nav>
    </aside>

    <!-- Admin Category Management -->
    <main class="flex-grow p-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-6">Manage Categories</h2>

      <!-- Add Category Form -->
      <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h3 class="text-xl font-semibold text-gray-700 mb-4">Add New Category</h3>
        <form action="/admin/categories/add?success=true" method="POST" enctype="multipart/form-data" onsubmit="validateCategoryName(event)">
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-600">Category Name</label>
            <input type="text" name="name" class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-600">Category Image</label>
            <input type="file" name="image" class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
          </div>
          <button type="submit" class="w-full bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition">Add Category</button>
        </form>
      </div>

      <!-- Display Categories -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-xl font-semibold text-gray-700 mb-4">Existing Categories</h3>
        <ul class="space-y-4">
          {{#each categories}}
          <li class="flex items-center justify-between bg-gray-50 rounded-lg p-4 shadow-sm">
            <div class="flex items-center">
              <img src="/uploads/{{this.image}}" alt="{{this.name}}" class="w-16 h-16 rounded-lg object-cover">
              <span class="ml-4 font-medium text-gray-800">{{this.name}}</span>
            </div>
            <div class="space-x-2">
              <!-- Edit Link with Confirmation -->
              <a href="/admin/categories/edit/{{this.id}}" onclick="confirmEdit(event)" class="bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600 transition">Edit</a>
              
              <!-- Delete Form with Confirmation -->
              <form action="/admin/categories/delete/{{this.id}}" method="POST" class="inline" onsubmit="confirmDelete(event)">
                <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">Delete</button>
              </form>
            </div>
          </li>
          {{/each}}
        </ul>
      </div>
    </main>
  </div>
<script>
  // Function to handle form submission via AJAX
  document.querySelector('form').addEventListener('submit', async function (event) {
  event.preventDefault(); // Prevent default form submission

  let categoryName = document.querySelector('input[name="name"]').value.trim();

  // Normalize spaces (convert multiple spaces into a single space)
  categoryName = categoryName.replace(/\s+/g, ' ');

  // Check if the category name is empty or contains lowercase letters
  if (categoryName === '') {
    Swal.fire({
      icon: 'error',
      title: 'Invalid Name',
      text: 'Category name cannot be empty or just spaces!',
    });
    return;
  }

  if (!/^[A-Z\s]+$/.test(categoryName)) {
    Swal.fire({
      icon: 'error',
      title: 'Invalid Name',
      text: 'Category name must contain only uppercase letters.',
    });
    return;
  }

  const formData = new FormData(this);
  formData.set('name', categoryName); // Update the form data with the normalized name

  try {
    const response = await fetch('/admin/categories/add', {
      method: 'POST',
      body: formData,
    });

    const result = await response.json();

    if (response.status === 200) {
      Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: 'Category added successfully!',
        confirmButtonColor: '#3085d6',
      }).then(() => {
        window.location.href = '/admin/categories';
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: result.message,
      });
    }
  } catch (error) {
    console.error('Error:', error);
    Swal.fire({
      icon: 'error',
      title: 'Server Error',
      text: 'Something went wrong. Please try again later.',
    });
  }
});

// Confirm before editing a category
  function confirmEdit(event) {
    event.preventDefault();
    Swal.fire({
      title: "Are you sure?",
     
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes!"
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = event.target.href;
      }
    });
  }

  // Confirm before deleting a category
  function confirmDelete(event) {
    event.preventDefault();
    Swal.fire({
      title: "Are you sure?",
    
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#3085d6",
      confirmButtonText: "Yes!"
    }).then((result) => {
      if (result.isConfirmed) {
        event.target.closest("form").submit();
      }
    });
  }
</script>
 

</body>
</html>  